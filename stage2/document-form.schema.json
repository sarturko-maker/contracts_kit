        "source_path": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "file_type": {
          "enum": [
            "pdf",
            "docx",
            "image",
            "not_found"
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{64}|not_found)$"
        },
        "pages": {
          "type": "string",
          "pattern": "^(?:[1-9][0-9]*|not_found|)$"
        },
        "text_or_scan": {
          "type": "string"
        },
        "language_guess": {
          "type": "string"
        },
        "docx_author": {
          "type": "string"
        },
        "docx_dates": {
          "type": "string"
        },
        "docx_tracked_changes": {
          "type": "string"
        },
        "side": {
