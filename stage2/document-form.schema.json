          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "topic",
        "part",
        "page_or_clause",
        "words",
        "reading"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "topic": {
                "const": "freight"
              }
            }
          },
          "then": {
            "properties": {
              "reading": {
                "enum": [
                  "charged_at_cost",
                  "charged_basis_unspecified",
                  "charged_with_margin",
                  "included_in_price",
                  "customer_arranges",
                  "silent",
                  "not_found"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "topic": {
                "const": "pricing"
              }
            }
          },
          "then": {
            "properties": {
              "reading": {
                "enum": [
                  "fixed_prices",
                  "price_list_referenced",
                  "cost_plus",
                  "silent",
                  "not_found"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "topic": {
                "const": "payment_terms"
              }
            }
          },
          "then": {
            "properties": {
              "reading": {
                "type": "string",
                "pattern": "^(?:[1-9][0-9]* days from .+|silent|not_found)$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "topic": {
                "const": "termination_for_convenience"
              }
            }
          },
          "then": {
            "properties": {
              "reading": {
                "type": "string",
                "pattern": "^(?:yes \\([^()]+\\)|no|not_found)$"
              }
            }
          }
        }
      ]
