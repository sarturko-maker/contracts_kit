          "enum": [
            "freight",
            "pricing",
            "payment_terms",
            "termination_for_convenience"
          ]
        },
        "part": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "page_or_clause": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "words": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
