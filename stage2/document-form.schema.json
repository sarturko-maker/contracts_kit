          "minLength": 1,
          "pattern": "\\S"
        },
        "folder": {
          "enum": [
            "1-governs-trade",
            "2-governs-part-of-trade",
            "3-live-not-trade",
            "4-not-live",
            "5-orders-drafts-duplicates",
            "6-business-practice",
            "unsure",
            "not_found"
          ]
        }
      },
      "required": [
        "doc_id",
        "source_path",
        "file_type",
        "sha256",
        "pages",
        "text_or_scan",
        "language_guess",
        "docx_author",
